# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies (Root & Workspaces)
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Agent Skills, LLM & Local Scratch Files
.agents/
*/.agents/
.agent/
.gemini/
.claude/
.cursor/

# Testing & Coverage
coverage/
*.lcov

# Next.js Build, Output & Cache (Root & Workspaces)
.next/
*/.next/
out/
*/out/
build/
*/build/
dist/
*/dist/

# Production Exports & Static
*.tsbuildinfo
next-env.d.ts
*/next-env.d.ts

# Misc & OS Files
.DS_Store
*.pem
Thumbs.db

# Debug & Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
*/logs/

# Environment Files (Credentials / Secrets)
.env
.env*
!.env.example

# Vercel & Deployment
.vercel/
*/.vercel/

# IDE & Editor Local Configs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
